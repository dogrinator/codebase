<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{6bc6223d-2cd4-47db-ac9d-d10a27a83f14}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR
	fbSafetyX : fb_safety;
	fbSafetyY : fb_safety;
	fbSystemBufferX : fb_StatusBuffer;
	fbSystemBufferY : fb_StatusBuffer;
	fbMovementControlerX : fb_MovementControler;
	fbMovementControlerY : fb_MovementControler;
	
	// DUTs import
	stMoveCommandX : ST_MoveCommand;
	stMoveCommandY : ST_MoveCommand;

	stSystemStatusX : ST_SystemStatus;
	stSystemStatusY : ST_SystemStatus;

	stSettingsX : ST_settings;
	stSettingsY : ST_settings;

	// IO Links
    nRawTenzoX AT %I* : DINT;
	nRawTenzoY AT %I* : DINT;

	nEndStopLx AT %I* : BOOL;
	nEndStopHx AT %I* : BOOL;

	nEndStopLy AT %I* : BOOL;
	nEndStopHy AT %I* : BOOL;

	// Normalized physical limits: TRUE means that the switch is pressed.
	bEndStopLxActive : BOOL;
	bEndStopHxActive : BOOL;
	bEndStopLyActive : BOOL;
	bEndStopHyActive : BOOL;

	// PLC-owned synchronized start and barrier coordinator
	bStartBiaxialTest : BOOL; // ADS one-shot after both axis commands are prepared
	bBiaxialSyncActive : BOOL;
	bBiaxialSyncRelease : BOOL;
	bBiaxialSyncAbort : BOOL;
	bBiaxialCommonAbort : BOOL;
	bBiaxialAbortX : BOOL;
	bBiaxialAbortY : BOOL;
	bBiaxialFinishAfterScan : BOOL;
	bBiaxialStartValid : BOOL;
	bBiaxialStartError : BOOL;
	nBiaxialStartErrorCode : UDINT;

	// Position origin used by the sample written in the current scan
	fBufferStartPositionX : LREAL;
	fBufferStartPositionY : LREAL;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[////////////////////////////////
//////////   safety   //////////
////////////////////////////////

// Refresh NC status before making any safety or motion decision
GVL_Axis.xAxis.ReadStatus();
GVL_Axis.yAxis.ReadStatus();

// Normalize the active-low physical switches
bEndStopLxActive := NOT nEndStopLx;
bEndStopHxActive := NOT nEndStopHx;
bEndStopLyActive := NOT nEndStopLy;
bEndStopHyActive := NOT nEndStopHy;

fbSafetyX(
    stAxis := GVL_Axis.xAxis,
    bPower := stMoveCommandX.bPower,
    bReset := stMoveCommandX.bReset,
    bHalt := stMoveCommandX.bHalt OR fbMovementControlerX.stateHalt,
    bHome := stMoveCommandX.bHome,
    bEndStopL := bEndStopLxActive,
	bEndStopH := bEndStopHxActive,
	bExternalBusy := fbMovementControlerX.bBusy OR stSystemStatusX.bTarWorking
);

fbSafetyY(
    stAxis := GVL_Axis.yAxis,
    bPower := stMoveCommandY.bPower,
    bReset := stMoveCommandY.bReset,
    bHalt := stMoveCommandY.bHalt OR fbMovementControlerY.stateHalt,
    bHome := stMoveCommandY.bHome,
	bEndStopL := bEndStopLyActive,
	bEndStopH := bEndStopHyActive,
	bExternalBusy := fbMovementControlerY.bBusy OR stSystemStatusY.bTarWorking
);

////////////////////////////////
////////// Update data /////////
////////////////////////////////

// The buffer runs before the movement controller so force feedback remains
// current in this scan. On an operation-start scan, use the actual position
// immediately; the controller captures the same value later in this scan.
fBufferStartPositionX := fbMovementControlerX.fTestStartPos;
fBufferStartPositionY := fbMovementControlerY.fTestStartPos;

IF NOT fbMovementControlerX.bBusy AND
	(stMoveCommandX.bExecute OR stMoveCommandX.bRestorePosition OR
	 bStartBiaxialTest) THEN
	fBufferStartPositionX := GVL_Axis.xAxis.NcToPlc.ActPos;
END_IF

IF NOT fbMovementControlerY.bBusy AND
	(stMoveCommandY.bExecute OR stMoveCommandY.bRestorePosition OR
	 bStartBiaxialTest) THEN
	fBufferStartPositionY := GVL_Axis.yAxis.NcToPlc.ActPos;
END_IF

fbSystemBufferX(
	stSystemStatus:= stSystemStatusX,
	bBlockTar:= fbMovementControlerX.bBusy OR fbSafetyX.bHoming,
	nRawTenzo:= nRawTenzoX,
	fTenzoCons:=stSettingsX.fTenzoCons,
	fTenzoOffset:= stSettingsX.fTenzoOffset,
	bStartTar:= stMoveCommandX.bStartTar,
	fActPosition:= GVL_Axis.xAxis.NcToPlc.ActPos,
	fStartPosition:= fBufferStartPositionX);
	
fbSystemBufferY(
	stSystemStatus:= stSystemStatusY,
	bBlockTar:= fbMovementControlerY.bBusy OR fbSafetyY.bHoming,
	nRawTenzo:= nRawTenzoY,
	fTenzoCons:=stSettingsY.fTenzoCons,
	fTenzoOffset:= stSettingsY.fTenzoOffset,
	bStartTar:= stMoveCommandY.bStartTar,
	fActPosition:= GVL_Axis.yAxis.NcToPlc.ActPos,
	fStartPosition:= fBufferStartPositionY);

/////////////////////////////////////
////////// Main Move Logic //////////
/////////////////////////////////////

// A shared request starts both axes in one PLC scan. Single-axis tests keep
// using their individual bExecute fields and never enable these barriers.
bBiaxialSyncRelease := FALSE;
bBiaxialSyncAbort := FALSE;
bBiaxialCommonAbort := FALSE;
bBiaxialAbortX := FALSE;
bBiaxialAbortY := FALSE;
bBiaxialFinishAfterScan := FALSE;

IF (stMoveCommandX.bReset OR stMoveCommandY.bReset) AND
	NOT bBiaxialSyncActive THEN
	bBiaxialStartError := FALSE;
	nBiaxialStartErrorCode := 0;
END_IF

IF bStartBiaxialTest THEN
	bStartBiaxialTest := FALSE;
	bBiaxialStartValid :=
		NOT bBiaxialSyncActive AND
		NOT fbMovementControlerX.bBusy AND
		NOT fbMovementControlerY.bBusy AND
		NOT fbMovementControlerX.bError AND
		NOT fbMovementControlerY.bError AND
		NOT fbSafetyX.bError AND NOT fbSafetyY.bError AND
		NOT fbSafetyX.bHoming AND NOT fbSafetyY.bHoming AND
		NOT stSystemStatusX.bTarWorking AND
		NOT stSystemStatusY.bTarWorking AND
		fbSafetyX.bPowerStatus AND fbSafetyY.bPowerStatus AND
		stMoveCommandX.nMode = 3 AND stMoveCommandY.nMode = 3 AND
		stMoveCommandX.nCycleCount >= 0 AND
		stMoveCommandX.nCycleCount <= 50 AND
		stMoveCommandY.nCycleCount >= 0 AND
		stMoveCommandY.nCycleCount <= 50 AND
		stMoveCommandX.nPreCycleCount >= 0 AND
		stMoveCommandX.nPreCycleCount <= 50 AND
		stMoveCommandY.nPreCycleCount >= 0 AND
		stMoveCommandY.nPreCycleCount <= 50 AND
		stMoveCommandX.nCycleCount = stMoveCommandY.nCycleCount AND
		stMoveCommandX.bIncludePreTest =
			stMoveCommandY.bIncludePreTest AND
		stMoveCommandX.bPreTestOnly = stMoveCommandY.bPreTestOnly AND
		stMoveCommandX.nPreCycleCount =
			stMoveCommandY.nPreCycleCount AND
		stMoveCommandX.bPreloadEnabled =
			stMoveCommandY.bPreloadEnabled AND
		stMoveCommandX.bPreUnloadToStart =
			stMoveCommandY.bPreUnloadToStart AND
		stMoveCommandX.nPostTestMode =
			stMoveCommandY.nPostTestMode AND
		NOT (stMoveCommandX.bPreTestOnly AND
			NOT stMoveCommandX.bIncludePreTest);

	IF bBiaxialStartValid THEN
		IF stMoveCommandX.nPostTestMode < 0 OR
			stMoveCommandX.nPostTestMode > 4 THEN
			bBiaxialStartValid := FALSE;
		ELSIF stMoveCommandX.nPostTestMode = 1 AND
			(NOT fbMovementControlerX.bSavedPositionValid OR
			 NOT fbMovementControlerY.bSavedPositionValid) THEN
			bBiaxialStartValid := FALSE;
		ELSIF NOT stMoveCommandX.bPreTestOnly AND
			stMoveCommandX.nCycleCount = 0 AND
			((stMoveCommandX.nStop1Mode < 1) OR
			 (stMoveCommandX.nStop1Mode > 2) OR
			 (stMoveCommandY.nStop1Mode < 1) OR
			 (stMoveCommandY.nStop1Mode > 2) OR
			 (stMoveCommandX.nStop2Mode < 0) OR
			 (stMoveCommandX.nStop2Mode > 2) OR
			 (stMoveCommandY.nStop2Mode < 0) OR
			 (stMoveCommandY.nStop2Mode > 2)) THEN
			bBiaxialStartValid := FALSE;
		ELSIF NOT stMoveCommandX.bPreTestOnly AND
			stMoveCommandX.nCycleCount > 0 AND
			((stMoveCommandX.nLoadMode < 1) OR
			 (stMoveCommandX.nLoadMode > 2) OR
			 (stMoveCommandY.nLoadMode < 1) OR
			 (stMoveCommandY.nLoadMode > 2) OR
			 (stMoveCommandX.nUnloadMode < 1) OR
			 (stMoveCommandX.nUnloadMode > 2) OR
			 (stMoveCommandY.nUnloadMode < 1) OR
			 (stMoveCommandY.nUnloadMode > 2)) THEN
			bBiaxialStartValid := FALSE;
		END_IF
	END_IF

	IF bBiaxialStartValid THEN
		bBiaxialStartError := FALSE;
		nBiaxialStartErrorCode := 0;
		bBiaxialSyncActive := TRUE;
		stMoveCommandX.bExecute := TRUE;
		stMoveCommandY.bExecute := TRUE;
	ELSE
		bBiaxialStartError := TRUE;
		nBiaxialStartErrorCode := 2010;
	END_IF
END_IF

IF bBiaxialSyncActive THEN
	// Ignore a ProtectiveStop produced by the controller's own stateHalt.
	// Operator/end-stop stops still abort both axes. During overforce relief,
	// only the peer receives the controller's explicit abort request.
	bBiaxialCommonAbort :=
		fbMovementControlerX.bError OR fbMovementControlerY.bError OR
		fbSafetyX.bError OR fbSafetyY.bError OR
		(fbSafetyX.bProtectiveStop AND
		 NOT fbMovementControlerX.stateHalt) OR
		(fbSafetyY.bProtectiveStop AND
		 NOT fbMovementControlerY.stateHalt) OR
		(bEndStopLxActive AND GVL_Axis.xAxis.Status.NegativeDirection) OR
		(bEndStopHxActive AND GVL_Axis.xAxis.Status.PositiveDirection) OR
		(bEndStopLyActive AND GVL_Axis.yAxis.Status.NegativeDirection) OR
		(bEndStopHyActive AND GVL_Axis.yAxis.Status.PositiveDirection) OR
		stMoveCommandX.bHalt OR stMoveCommandY.bHalt;

	bBiaxialAbortX := bBiaxialCommonAbort OR
		fbMovementControlerY.bPeerAbortRequest;
	bBiaxialAbortY := bBiaxialCommonAbort OR
		fbMovementControlerX.bPeerAbortRequest;
	bBiaxialSyncAbort := bBiaxialCommonAbort OR
		fbMovementControlerX.bPeerAbortRequest OR
		fbMovementControlerY.bPeerAbortRequest;

	IF NOT bBiaxialSyncAbort AND
		fbMovementControlerX.nSyncPoint <> 0 AND
		fbMovementControlerX.nSyncPoint =
			fbMovementControlerY.nSyncPoint AND
		fbMovementControlerX.nSyncCycle =
			fbMovementControlerY.nSyncCycle THEN
		bBiaxialSyncRelease := TRUE;
		bBiaxialFinishAfterScan :=
			fbMovementControlerX.nSyncPoint = 5;
	END_IF
END_IF

fbMovementControlerX(
	Axis := GVL_Axis.xAxis,
	stMoveCommand := stMoveCommandX,
	stSettings := stSettingsX,
	fActPosition := GVL_Axis.xAxis.NcToPlc.ActPos,
    bPowerState := fbSafetyX.bPowerStatus,
	bHaltDone := fbSafetyX.bHaltDone,
	bSafetyError := fbSafetyX.bError,
	bProtectiveStop := fbSafetyX.bProtectiveStop,
	bExternalBusy := fbSafetyX.bHoming OR stSystemStatusX.bTarWorking,
	bSyncEnabled := bBiaxialSyncActive,
	bSyncRelease := bBiaxialSyncRelease,
	bSyncAbort := bBiaxialAbortX,
    fForce := stSystemStatusX.fTenzoBuffer[stSystemStatusX.nBufferHead]);

fbMovementControlerY(
	Axis := GVL_Axis.yAxis,
	stMoveCommand := stMoveCommandY,
	stSettings := stSettingsY,
	fActPosition := GVL_Axis.yAxis.NcToPlc.ActPos,
    bPowerState := fbSafetyY.bPowerStatus,
	bHaltDone := fbSafetyY.bHaltDone,
	bSafetyError := fbSafetyY.bError,
	bProtectiveStop := fbSafetyY.bProtectiveStop,
	bExternalBusy := fbSafetyY.bHoming OR stSystemStatusY.bTarWorking,
	bSyncEnabled := bBiaxialSyncActive,
	bSyncRelease := bBiaxialSyncRelease,
	bSyncAbort := bBiaxialAbortY,
	fForce := stSystemStatusY.fTenzoBuffer[stSystemStatusY.nBufferHead]);

IF bBiaxialFinishAfterScan OR
	(bBiaxialSyncAbort AND NOT fbMovementControlerX.bBusy AND
		NOT fbMovementControlerY.bBusy) THEN
	bBiaxialSyncActive := FALSE;
	bBiaxialSyncRelease := FALSE;
	bBiaxialSyncAbort := FALSE;
	bBiaxialCommonAbort := FALSE;
	bBiaxialAbortX := FALSE;
	bBiaxialAbortY := FALSE;
END_IF

///////////////////////////////////////////////////
////// ADS status contract for each axis //////////
///////////////////////////////////////////////////

stSystemStatusX.fActPosition := GVL_Axis.xAxis.NcToPlc.ActPos;
stSystemStatusX.bPowered := fbSafetyX.bPowerStatus;
stSystemStatusX.bHoming := fbSafetyX.bHoming;
stSystemStatusX.bHomed := fbSafetyX.bHomed;
stSystemStatusX.bStopped := fbSafetyX.bStopped;
stSystemStatusX.bWorking := fbMovementControlerX.bBusy OR fbSafetyX.bHoming OR
	fbSafetyX.bProtectiveStop OR stSystemStatusX.bTarWorking;
stSystemStatusX.nOperationCounter := fbMovementControlerX.nOperationCounter;
stSystemStatusX.nInterfaceVersion := 5;
stSystemStatusX.bSavedPositionValid := fbMovementControlerX.bSavedPositionValid;
stSystemStatusX.nTestPhase := fbMovementControlerX.nTestPhase;
stSystemStatusX.bError := fbMovementControlerX.bError OR fbSafetyX.bError OR
	bBiaxialStartError;
IF fbSafetyX.bError THEN
	stSystemStatusX.nErrorCode := fbSafetyX.nErrorCode;
	stSystemStatusX.nAxisErrorID := fbSafetyX.nAxisErrorID;
ELSIF bBiaxialStartError THEN
	stSystemStatusX.nErrorCode := nBiaxialStartErrorCode;
	stSystemStatusX.nAxisErrorID := 0;
ELSE
	stSystemStatusX.nErrorCode := fbMovementControlerX.nErrorCode;
	stSystemStatusX.nAxisErrorID := fbMovementControlerX.nAxisErrorID;
END_IF

stSystemStatusY.fActPosition := GVL_Axis.yAxis.NcToPlc.ActPos;
stSystemStatusY.bPowered := fbSafetyY.bPowerStatus;
stSystemStatusY.bHoming := fbSafetyY.bHoming;
stSystemStatusY.bHomed := fbSafetyY.bHomed;
stSystemStatusY.bStopped := fbSafetyY.bStopped;
stSystemStatusY.bWorking := fbMovementControlerY.bBusy OR fbSafetyY.bHoming OR
	fbSafetyY.bProtectiveStop OR stSystemStatusY.bTarWorking;
stSystemStatusY.nOperationCounter := fbMovementControlerY.nOperationCounter;
stSystemStatusY.nInterfaceVersion := 5;
stSystemStatusY.bSavedPositionValid := fbMovementControlerY.bSavedPositionValid;
stSystemStatusY.nTestPhase := fbMovementControlerY.nTestPhase;
stSystemStatusY.bError := fbMovementControlerY.bError OR fbSafetyY.bError OR
	bBiaxialStartError;
IF fbSafetyY.bError THEN
	stSystemStatusY.nErrorCode := fbSafetyY.nErrorCode;
	stSystemStatusY.nAxisErrorID := fbSafetyY.nAxisErrorID;
ELSIF bBiaxialStartError THEN
	stSystemStatusY.nErrorCode := nBiaxialStartErrorCode;
	stSystemStatusY.nAxisErrorID := 0;
ELSE
	stSystemStatusY.nErrorCode := fbMovementControlerY.nErrorCode;
	stSystemStatusY.nAxisErrorID := fbMovementControlerY.nAxisErrorID;
END_IF

// Home and reset are one-shot commands
stMoveCommandX.bHome := FALSE;
stMoveCommandY.bHome := FALSE;
stMoveCommandX.bReset := FALSE;
stMoveCommandY.bReset := FALSE;
stMoveCommandX.bSavePosition := FALSE;
stMoveCommandY.bSavePosition := FALSE;
stMoveCommandX.bRestorePosition := FALSE;
stMoveCommandY.bRestorePosition := FALSE;









]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="6943" Count="57" />
      <LineId Id="7035" Count="0" />
      <LineId Id="7037" Count="0" />
      <LineId Id="7030" Count="0" />
      <LineId Id="7002" Count="1" />
      <LineId Id="7036" Count="0" />
      <LineId Id="7007" Count="2" />
      <LineId Id="7034" Count="0" />
      <LineId Id="7039" Count="0" />
      <LineId Id="7032" Count="0" />
      <LineId Id="7011" Count="1" />
      <LineId Id="7038" Count="0" />
      <LineId Id="7016" Count="9" />
      <LineId Id="65" Count="0" />
      <LineId Id="87" Count="1" />
      <LineId Id="7070" Count="1" />
      <LineId Id="89" Count="0" />
      <LineId Id="7073" Count="1" />
      <LineId Id="7072" Count="0" />
      <LineId Id="90" Count="47" />
      <LineId Id="143" Count="7" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
