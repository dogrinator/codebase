<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="fb_StatusBuffer" Id="{b8a883a1-d10e-4ae2-918d-ef376e1e59b0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fb_StatusBuffer
VAR_IN_OUT
    stSystemStatus    : ST_SystemStatus;
    bStartTar         : BOOL;  // Cleared after completion or when tare is blocked
END_VAR
VAR_INPUT
	bBlockTar     : BOOL;  // Motion or homing is active

	// Tenzo buffer
    nRawTenzo    : DINT;
    fTenzoCons   : LREAL;
    fTenzoOffset : LREAL;
	
	// Position buffer
	fActPosition   : LREAL;
END_VAR
VAR
    fbStartTarRiseClp : R_TRIG;   // Detects the moment tare button is pressed
    bTarActive        : BOOL;     // Flag indicating taring is in progress
    nTarCounter       : INT;      // Counts up to 100 samples
    fTarAccumulator   : LREAL;    // Holds the running sum of samples
END_VAR
VAR_TEMP
    fCurrentCalculated: LREAL;    // Current force before the tare offset
	nNextHead        : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Calculate the current weight snapshot
fCurrentCalculated := (DINT_TO_LREAL(nRawTenzo) * fTenzoCons) + fTenzoOffset;

// Tare logic
// Reject a tare command received while motion or homing is active.
IF bStartTar AND bBlockTar THEN
	bStartTar := FALSE;
END_IF

fbStartTarRiseClp(CLK := bStartTar);

// Start the taring process
IF fbStartTarRiseClp.Q AND NOT bTarActive THEN
    bTarActive      := TRUE;
    nTarCounter     := 0;
    fTarAccumulator := 0.0;
END_IF

IF bTarActive THEN
    // Accumulate the current weight across 100 consecutive cycles
    fTarAccumulator := fTarAccumulator + fCurrentCalculated;
    nTarCounter     := nTarCounter + 1;
    
    // After 100 samples
    IF nTarCounter >= 100 THEN
        // Calculate the mean
        stSystemStatus.fTenzoTarOffset := - (fTarAccumulator / 100.0); 
        
        // Reset control flags
        bTarActive := FALSE;
        bStartTar  := FALSE;
    END_IF
END_IF

// Block movement while tare calculation is active.
stSystemStatus.bTarWorking := bTarActive;

// New head
nNextHead := stSystemStatus.nBufferHead + 1;
IF nNextHead > 50 THEN
    nNextHead := 1;
END_IF

// Buffering data
stSystemStatus.fTenzoBuffer[nNextHead] := fCurrentCalculated + stSystemStatus.fTenzoTarOffset;
stSystemStatus.fPosBuffer[nNextHead] := fActPosition;

// MATLAB status helpers
stSystemStatus.nBufferHead := nNextHead;
stSystemStatus.nSampleCounter := stSystemStatus.nSampleCounter + 1;

]]></ST>
    </Implementation>
