      <LineId Id="1807" Count="0" />
    </LineIds>
    <LineIds Name="fb_MovementControler.mode1">
      <LineId Id="2" Count="0" />
      <LineId Id="87" Count="3" />
      <LineId Id="3" Count="0" />
      <LineId Id="98" Count="62" />
      <LineId Id="1" Count="0" />
      <LineId Id="72" Count="12" />
      <LineId Id="161" Count="0" />
    </LineIds>
    <LineIds Name="fb_MovementControler.mode2">
      <LineId Id="64" Count="5" />
      <LineId Id="2" Count="0" />
      <LineId Id="70" Count="0" />
      <LineId Id="3" Count="4" />
      <LineId Id="73" Count="0" />
      <LineId Id="8" Count="13" />
      <LineId Id="74" Count="0" />
      <LineId Id="22" Count="4" />
      <LineId Id="71" Count="1" />
      <LineId Id="27" Count="3" />
      <LineId Id="32" Count="9" />
      <LineId Id="75" Count="3" />
      <LineId Id="46" Count="17" />
      <LineId Id="1" Count="0" />
      <LineId Id="138" Count="3" />
      <LineId Id="79" Count="58" />
      <LineId Id="142" Count="5" />
    </LineIds>
  </POU>
</TcPlcObject>
