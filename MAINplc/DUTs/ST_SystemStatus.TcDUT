    fTenzoBuffer : ARRAY[1..500] OF REAL; // Histórie za posledných 0.5 sekundy (pri 1ms cykle)
    nBufferHead  : INT := 1;              // Ukazovateľ, kam sa zapíše ĎALŠIA hodnota
    
	bWorking : BOOL;   // PLC ocupied. Do not send data to PLC
	
    bError     : BOOL; // Systém v chybe(TODO)
END_STRUCT
END_TYPE
]]></Declaration>
