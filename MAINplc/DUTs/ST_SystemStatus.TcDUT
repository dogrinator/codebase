  <DUT Name="ST_SystemStatus" Id="{1f1ade43-23d7-4c7e-a80f-ab809b514cde}">
    <Declaration><![CDATA[TYPE ST_SystemStatus :
	STRUCT
		fTenzoBuffer : ARRAY[1..150] OF LREAL; // FIFO tenzo data
		nBufferHead  : INT := 1;              // Pointer to head
		
		bWorking     : BOOL;                  // PLC ocupied. Do not send data to PLC
		bError       : BOOL;                  // Sys in error(TODO)
	END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
