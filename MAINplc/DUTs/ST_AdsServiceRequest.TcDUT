<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_AdsServiceRequest" Id="{4afcc8ac-c2c1-4f9d-9799-07d5a408453a}">
    <Declaration><![CDATA[
{attribute 'pack_mode' := '1'}
TYPE ST_AdsServiceRequest :
	STRUCT
		nMagic : UDINT := 16#41535256;       // "ASRV"
		nFormatVersion : UINT := 2;
		nPayloadSize : UINT := 40;
		nSequenceStart : UDINT := 0;
		nRequestId : UDINT := 0;
		nAxisMask : BYTE := 0;
		nServiceCode : BYTE := 0;            // 1 halt, 2/3 power, 4 reset,
		                                     // 5 home, 6 tare, 7 save, 8 restore
		nReserved : UINT := 0;
		fRestoreVelocityX : LREAL := 0.0;
		fRestoreVelocityY : LREAL := 0.0;
		nSequenceEnd : UDINT := 0;
	END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
