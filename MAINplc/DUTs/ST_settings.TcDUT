<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_Settings" Id="{4c7494d5-7e0d-4afe-afc6-07f6109539eb}">
    <Declaration><![CDATA[TYPE ST_Settings :
	STRUCT
		// Force-sensor calibration
		fTenzoCons   : LREAL := 0.01;
		fTenzoOffset : LREAL := 0.0;

		// Force control
		fKp : LREAL := 10;
		fKi : LREAL := 0.1;
		fIntegralLimit  : LREAL := 10;
		fForceTolerance : LREAL := 0.1;
		fMaxVelocity    : LREAL := 100;

		// Runtime force limit
		fMaxForce            : LREAL := 10;
		fForceReliefDistance : LREAL := 1.0; // fixed overforce release move [mm]
		fForceReliefVelocity : LREAL := 1.0; // release speed [mm/s]
	END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
