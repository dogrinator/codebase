<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="fb_safety" Id="{2b1a91eb-6451-41aa-b214-38ff110b08ec}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fb_safety
VAR_INPUT
	bPower        : BOOL;
	bReset        : BOOL;
	bHalt         : BOOL;
	bHome         : BOOL;
	bEndStopL     : BOOL; // TRUE when the normalized lower switch is active
	bEndStopH     : BOOL; // TRUE when the normalized upper switch is active
	bExternalBusy : BOOL; // Test motion or tare is active
END_VAR

VAR_OUTPUT
	bPowerStatus       : BOOL;
	bHaltDone          : BOOL;
	bError             : BOOL;
	nErrorCode         : UDINT;
	nAxisErrorID       : UDINT;
	bHoming            : BOOL;
	bHomed             : BOOL;
	bStopped           : BOOL;
	bProtectiveStop    : BOOL; // Abort active test motion but retain commanded power
END_VAR

VAR_IN_OUT
	stAxis : AXIS_REF;
END_VAR

VAR
	fbPower        : MC_Power;
	fbReset        : MC_Reset;
	fbHalt         : MC_Halt;
	fbHome         : MC_Home;
	fbMoveToZero   : MC_MoveAbsolute;

	rtReset        : R_TRIG;
	rtHalt         : R_TRIG;
	rtHome         : R_TRIG;

	fbHomeTimeout  : TON;
	fbMoveTimeout  : TON;

	eState             : E_SafetyState := E_SafetyState.Idle;
	bFaultPowerInhibit : BOOL;
	bResetExecute      : BOOL;
	bHaltDonePulse     : BOOL;
	stHomeOptions      : ST_HomingOptions;
END_VAR

VAR CONSTANT
	HOME_PARK_POSITION : LREAL := 0.0;
	HOME_PARK_VELOCITY : LREAL := 5.0;
	HOME_TIMEOUT       : TIME := T#10M;
	HOME_PARK_TIMEOUT  : TIME := T#10S;
	ERROR_POWER_FB       : UDINT := 1001;
	ERROR_RESET_FB       : UDINT := 1002;
	ERROR_HALT_FB        : UDINT := 1003;
	ERROR_HOME_FB        : UDINT := 1004;
	ERROR_AXIS           : UDINT := 1005;
	ERROR_LIMITS_CONFLICT: UDINT := 1006;
	ERROR_PARK_FB        : UDINT := 1008;
	ERROR_HOME_TIMEOUT   : UDINT := 1011;
	ERROR_PARK_TIMEOUT   : UDINT := 1012;
	ERROR_UPPER_LIMIT    : UDINT := 1013;
	ERROR_HOME_LIMIT     : UDINT := 1014;
	ERROR_HOME_COORDINATE: UDINT := 1015;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Commands are edge-triggered
rtReset(CLK := bReset);
rtHalt(CLK := bHalt);
rtHome(CLK := bHome);

// Halt completion is exposed as a one-cycle pulse.
bHaltDonePulse := FALSE;

// Reset a latched fault
IF rtReset.Q AND bError AND eState = E_SafetyState.Idle THEN
	bResetExecute := TRUE;
END_IF

IF bResetExecute AND fbReset.Done THEN
	bResetExecute := FALSE;
	bError := FALSE;
	nErrorCode := 0;
	nAxisErrorID := 0;
	bFaultPowerInhibit := FALSE;
ELSIF bResetExecute AND fbReset.Error THEN
	bResetExecute := FALSE;
	bError := TRUE;
	nErrorCode := ERROR_RESET_FB;
	nAxisErrorID := fbReset.ErrorID;
	bFaultPowerInhibit := TRUE;
END_IF

// Latch genuine NC, wiring and motion-function-block faults
IF NOT bError THEN
	IF stAxis.Status.Error THEN
		bError := TRUE;
		nErrorCode := ERROR_AXIS;
		nAxisErrorID := stAxis.Status.ErrorID;
		eState := E_SafetyState.ErrorStop;
	ELSIF bEndStopL AND bEndStopH THEN
		bError := TRUE;
		nErrorCode := ERROR_LIMITS_CONFLICT;
		nAxisErrorID := 0;
		eState := E_SafetyState.ErrorStop;
	ELSIF fbPower.Error THEN
		bError := TRUE;
		nErrorCode := ERROR_POWER_FB;
		nAxisErrorID := fbPower.ErrorID;
		eState := E_SafetyState.ErrorStop;
	ELSIF fbHalt.Error THEN
		bError := TRUE;
		nErrorCode := ERROR_HALT_FB;
		nAxisErrorID := fbHalt.ErrorID;
		eState := E_SafetyState.ErrorStop;
	ELSIF fbHome.Error THEN
		bError := TRUE;
		nErrorCode := ERROR_HOME_FB;
		nAxisErrorID := fbHome.ErrorID;
		eState := E_SafetyState.ErrorStop;
	ELSIF fbMoveToZero.Error THEN
		bError := TRUE;
		nErrorCode := ERROR_PARK_FB;
		nAxisErrorID := fbMoveToZero.ErrorID;
		eState := E_SafetyState.ErrorStop;
	END_IF
END_IF

// Halt and switch to error stop
IF rtHalt.Q AND eState <> E_SafetyState.ErrorStop THEN
	eState := E_SafetyState.ProtectiveStop;
END_IF

CASE eState OF
	E_SafetyState.Idle:
		// Stop only when travelling farther into an active physical switch.
		IF (bEndStopL AND stAxis.Status.NegativeDirection) OR
			(bEndStopH AND stAxis.Status.PositiveDirection) THEN
			eState := E_SafetyState.ProtectiveStop;
		ELSIF rtHome.Q AND NOT bExternalBusy AND fbPower.Status THEN
			eState := E_SafetyState.Homing;
		END_IF

	E_SafetyState.Homing:
		IF fbHomeTimeout.Q THEN
			bError := TRUE;
			nErrorCode := ERROR_HOME_TIMEOUT;
			nAxisErrorID := 0;
			eState := E_SafetyState.ErrorStop;
		ELSIF fbHome.Done THEN
			IF bEndStopL THEN
				bError := TRUE;
				nErrorCode := ERROR_HOME_LIMIT;
				nAxisErrorID := 0;
				eState := E_SafetyState.ErrorStop;
			ELSIF NOT stAxis.Status.Homed OR
				stAxis.NcToPlc.ActPos < -10.0 OR
				stAxis.NcToPlc.ActPos > 0.5 THEN
				// Reject an invalid coordinate instead of commanding a long move.
				bError := TRUE;
				nErrorCode := ERROR_HOME_COORDINATE;
				nAxisErrorID := 0;
				eState := E_SafetyState.ErrorStop;
			ELSE
				eState := E_SafetyState.MoveToZero;
			END_IF
		END_IF

	E_SafetyState.MoveToZero:
		IF stAxis.Status.NegativeDirection THEN
			// Parking from the lower reference toward zero must be positive.
			bError := TRUE;
			nErrorCode := ERROR_HOME_COORDINATE;
			nAxisErrorID := 0;
			eState := E_SafetyState.ErrorStop;
		ELSIF bEndStopH THEN
			bError := TRUE;
			nErrorCode := ERROR_UPPER_LIMIT;
			nAxisErrorID := 0;
			eState := E_SafetyState.ErrorStop;
		ELSIF fbMoveTimeout.Q THEN
			bError := TRUE;
			nErrorCode := ERROR_PARK_TIMEOUT;
			nAxisErrorID := 0;
			eState := E_SafetyState.ErrorStop;
		ELSIF fbMoveToZero.Done THEN
			eState := E_SafetyState.Complete;
		END_IF

	E_SafetyState.Complete:
		eState := E_SafetyState.Idle;

	E_SafetyState.ProtectiveStop:
		IF fbHalt.Done OR stAxis.Status.StandStill THEN
			bHaltDonePulse := TRUE;
			eState := E_SafetyState.Idle;
		END_IF

	E_SafetyState.ErrorStop:
		IF fbHalt.Done OR stAxis.Status.StandStill THEN
			bHaltDonePulse := TRUE;
			bFaultPowerInhibit := TRUE;
			eState := E_SafetyState.Idle;
		END_IF
END_CASE

fbHomeTimeout(
	IN := eState = E_SafetyState.Homing,
	PT := HOME_TIMEOUT);
fbMoveTimeout(
	IN := eState = E_SafetyState.MoveToZero,
	PT := HOME_PARK_TIMEOUT);

// Physical switches continuously block motion farther into the active limit
fbPower(
	Axis := stAxis,
	Enable := bPower AND NOT bFaultPowerInhibit,
	Enable_Positive := bPower AND NOT bFaultPowerInhibit AND NOT bEndStopH,
	Enable_Negative := bPower AND NOT bFaultPowerInhibit AND (NOT bEndStopL OR eState = E_SafetyState.Homing),
	Override := 100.0);

fbReset(
	Axis := stAxis,
	Execute := bResetExecute);

// Make both homing directions explicit:
// search toward the lower switch, then move positively away from it.
stHomeOptions.SearchDirection :=
	MC_Direction.MC_Negative_Direction;
stHomeOptions.SearchVelocity := 5;
stHomeOptions.SyncDirection :=
	MC_Direction.MC_Positive_Direction;
stHomeOptions.SyncVelocity := 2;
stHomeOptions.ReferenceMode :=
	E_EncoderReferenceMode.ENCODERREFERENCEMODE_PLCCAM;

// TwinCAT NC owns the complete reference-cam search and release sequence.
fbHome(
	Axis := stAxis,
	Execute := eState = E_SafetyState.Homing,
	Position := -5.0,
	HomingMode := MC_DefaultHoming,
	BufferMode := MC_Aborting,
	Options := stHomeOptions,
	bCalibrationCam := bEndStopL);

// Park at the safe working origin after TwinCAT has established the reference.
fbMoveToZero(
	Axis := stAxis,
	Execute := eState = E_SafetyState.MoveToZero,
	Position := HOME_PARK_POSITION,
	Velocity := HOME_PARK_VELOCITY,
	BufferMode := MC_Aborting);

fbHalt(
	Axis := stAxis,
	Execute := eState = E_SafetyState.ProtectiveStop OR
		eState = E_SafetyState.ErrorStop);

// Public status.
bPowerStatus := fbPower.Status;
bHaltDone := bHaltDonePulse OR fbHalt.Done;
bHoming := eState = E_SafetyState.Homing OR
	eState = E_SafetyState.MoveToZero;
bHomed := stAxis.Status.Homed;
bStopped := stAxis.Status.StandStill;
bProtectiveStop := eState = E_SafetyState.ProtectiveStop;
]]></ST>
    </Implementation>
    <LineIds Name="fb_safety">
      <LineId Id="1" Count="4" />
      <LineId Id="234" Count="0" />
      <LineId Id="6" Count="86" />
      <LineId Id="291" Count="0" />
      <LineId Id="93" Count="58" />
      <LineId Id="290" Count="0" />
      <LineId Id="152" Count="24" />
      <LineId Id="179" Count="0" />
      <LineId Id="183" Count="21" />
      <LineId Id="292" Count="0" />
    </LineIds>
  </POU>
