<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{6bc6223d-2cd4-47db-ac9d-d10a27a83f14}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR
	fbSafetyX : fb_safety;
	fbSafetyY : fb_safety;
	fbSystemBufferX : fb_StatusBuffer;
	fbSystemBufferY : fb_StatusBuffer;
	fbMovementControllerX : fb_MovementController;
	fbMovementControllerY : fb_MovementController;
	fbBiaxialCoordinator : fb_BiaxialCoordinator;
	fbStatusPublisherX : fb_AxisStatusPublisher;
	fbStatusPublisherY : fb_AxisStatusPublisher;
	
	// DUTs import
	stMoveCommandX : ST_MoveCommand;
	stMoveCommandY : ST_MoveCommand;

	stSystemStatusX : ST_SystemStatus;
	stSystemStatusY : ST_SystemStatus;

	stSettingsX : ST_Settings;
	stSettingsY : ST_Settings;

	// IO Links
    nRawTenzoX AT %I* : DINT;
	nRawTenzoY AT %I* : DINT;

	nEndStopLx AT %I* : BOOL;
	nEndStopHx AT %I* : BOOL;

	nEndStopLy AT %I* : BOOL;
	nEndStopHy AT %I* : BOOL;

	// Normalized physical limits: TRUE means that the switch is pressed.
	bEndStopLxActive : BOOL;
	bEndStopHxActive : BOOL;
	bEndStopLyActive : BOOL;
	bEndStopHyActive : BOOL;

	// PLC-owned synchronized start request
	bStartBiaxialTest : BOOL; // ADS one-shot after both axis commands are prepared

END_VAR

VAR_TEMP
	bBiaxialAxesReady : BOOL;
	bBiaxialCommonAbortRequest : BOOL;
	bRestoreReferenceX : BOOL;
	bRestoreReferenceY : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[////////////////////////////////
//////////   safety   //////////
////////////////////////////////

// Refresh NC status before making any safety or motion decision
GVL_Axis.xAxis.ReadStatus();
GVL_Axis.yAxis.ReadStatus();

// Requesting a physical home deliberately invalidates the old retained
// coordinate. Only a successfully referenced axis will make it valid again.
IF stMoveCommandX.bHome THEN
	GVL_Persistent.bLastPositionValidX := FALSE;
END_IF
IF stMoveCommandY.bHome THEN
	GVL_Persistent.bLastPositionValidY := FALSE;
END_IF

// On the first powered scan after a PLC/NC restart, statically restore each
// incremental axis to its last persistent coordinate. MC_Direct performs no
// motor movement. A normal reference-cam home always takes priority.
bRestoreReferenceX :=
	GVL_Persistent.bLastPositionValidX AND
	NOT GVL_Axis.xAxis.Status.Homed AND
	NOT fbSafetyX.bReferenceRestoreDone;
bRestoreReferenceY :=
	GVL_Persistent.bLastPositionValidY AND
	NOT GVL_Axis.yAxis.Status.Homed AND
	NOT fbSafetyY.bReferenceRestoreDone;

// Normalize the active-low physical switches
bEndStopLxActive := NOT nEndStopLx;
bEndStopHxActive := NOT nEndStopHx;
bEndStopLyActive := NOT nEndStopLy;
bEndStopHyActive := NOT nEndStopHy;

fbSafetyX(
    stAxis := GVL_Axis.xAxis,
    bPower := stMoveCommandX.bPower,
    bReset := stMoveCommandX.bReset,
    bHalt := stMoveCommandX.bHalt OR fbMovementControllerX.stateHalt,
    bHome := stMoveCommandX.bHome,
	bRestoreReference := bRestoreReferenceX,
	fRestoreReferencePosition := GVL_Persistent.fLastPositionX,
    bEndStopL := bEndStopLxActive,
	bEndStopH := bEndStopHxActive,
	bExternalBusy := fbMovementControllerX.bBusy OR stSystemStatusX.bTarWorking
);

fbSafetyY(
    stAxis := GVL_Axis.yAxis,
    bPower := stMoveCommandY.bPower,
    bReset := stMoveCommandY.bReset,
    bHalt := stMoveCommandY.bHalt OR fbMovementControllerY.stateHalt,
    bHome := stMoveCommandY.bHome,
	bRestoreReference := bRestoreReferenceY,
	fRestoreReferencePosition := GVL_Persistent.fLastPositionY,
    bEndStopL := bEndStopLyActive,
	bEndStopH := bEndStopHyActive,
	bExternalBusy := fbMovementControllerY.bBusy OR stSystemStatusY.bTarWorking
);

////////////////////////////////
////////// Update data /////////
////////////////////////////////

fbSystemBufferX(
	stSystemStatus:= stSystemStatusX,
	bBlockTar:= fbMovementControllerX.bBusy OR fbSafetyX.bHoming OR
		NOT fbSafetyX.bHomed,
	nRawTenzo:= -nRawTenzoX,
	fTenzoCons:=stSettingsX.fTenzoCons,
	fTenzoOffset:= stSettingsX.fTenzoOffset,
	bStartTar:= stMoveCommandX.bStartTar,
	fActPosition:= GVL_Axis.xAxis.NcToPlc.ActPos);
	
fbSystemBufferY(
	stSystemStatus:= stSystemStatusY,
	bBlockTar:= fbMovementControllerY.bBusy OR fbSafetyY.bHoming OR
		NOT fbSafetyY.bHomed,
	nRawTenzo:= nRawTenzoY,
	fTenzoCons:=stSettingsY.fTenzoCons,
	fTenzoOffset:= stSettingsY.fTenzoOffset,
	bStartTar:= stMoveCommandY.bStartTar,
	fActPosition:= GVL_Axis.yAxis.NcToPlc.ActPos);

/////////////////////////////////////
////////// Main Move Logic //////////
/////////////////////////////////////

// A shared request starts both axes in one PLC scan. Single-axis tests keep
// using their individual bExecute fields and never enable synchronization.
bBiaxialAxesReady :=
	NOT fbMovementControllerX.bBusy AND
	NOT fbMovementControllerY.bBusy AND
	NOT fbMovementControllerX.bError AND
	NOT fbMovementControllerY.bError AND
	NOT fbSafetyX.bError AND NOT fbSafetyY.bError AND
	NOT fbSafetyX.bHoming AND NOT fbSafetyY.bHoming AND
	fbSafetyX.bHomed AND fbSafetyY.bHomed AND
	NOT stSystemStatusX.bTarWorking AND
	NOT stSystemStatusY.bTarWorking AND
	fbSafetyX.bPowerStatus AND fbSafetyY.bPowerStatus;

// Ignore ProtectiveStop when it was produced by the controller's own
// controlled halt. Operator, end-stop and independent safety stops abort both
// axes; an overforce relief request aborts only the synchronized peer.
bBiaxialCommonAbortRequest :=
	fbMovementControllerX.bError OR fbMovementControllerY.bError OR
	fbSafetyX.bError OR fbSafetyY.bError OR
	(fbSafetyX.bProtectiveStop AND
	 NOT fbMovementControllerX.stateHalt) OR
	(fbSafetyY.bProtectiveStop AND
	 NOT fbMovementControllerY.stateHalt) OR
	(bEndStopLxActive AND GVL_Axis.xAxis.Status.NegativeDirection) OR
	(bEndStopHxActive AND GVL_Axis.xAxis.Status.PositiveDirection) OR
	(bEndStopLyActive AND GVL_Axis.yAxis.Status.NegativeDirection) OR
	(bEndStopHyActive AND GVL_Axis.yAxis.Status.PositiveDirection) OR
	stMoveCommandX.bHalt OR stMoveCommandY.bHalt;

fbBiaxialCoordinator(
	bStartRequest := bStartBiaxialTest,
	bResetRequest := stMoveCommandX.bReset OR stMoveCommandY.bReset,
	bAxesReady := bBiaxialAxesReady,
	bCommonAbortRequest := bBiaxialCommonAbortRequest,
	bBusyX := fbMovementControllerX.bBusy,
	bBusyY := fbMovementControllerY.bBusy,
	bSavedPositionValidX := fbMovementControllerX.bSavedPositionValid,
	bSavedPositionValidY := fbMovementControllerY.bSavedPositionValid,
	nSyncPointX := fbMovementControllerX.nSyncPoint,
	nSyncPointY := fbMovementControllerY.nSyncPoint,
	nSyncCycleX := fbMovementControllerX.nSyncCycle,
	nSyncCycleY := fbMovementControllerY.nSyncCycle,
	bPeerAbortRequestX := fbMovementControllerX.bPeerAbortRequest,
	bPeerAbortRequestY := fbMovementControllerY.bPeerAbortRequest,
	stCommandX := stMoveCommandX,
	stCommandY := stMoveCommandY);

IF bStartBiaxialTest THEN
	bStartBiaxialTest := FALSE;
END_IF

IF fbBiaxialCoordinator.bStartBoth THEN
	stMoveCommandX.bExecute := TRUE;
	stMoveCommandY.bExecute := TRUE;
END_IF

fbMovementControllerX(
	Axis := GVL_Axis.xAxis,
	stMoveCommand := stMoveCommandX,
	stSettings := stSettingsX,
	fActPosition := GVL_Axis.xAxis.NcToPlc.ActPos,
    bPowerState := fbSafetyX.bPowerStatus,
	bHaltDone := fbSafetyX.bHaltDone,
	bSafetyError := fbSafetyX.bError,
	bProtectiveStop := fbSafetyX.bProtectiveStop,
	bExternalBusy := fbSafetyX.bHoming OR
		NOT fbSafetyX.bHomed OR stSystemStatusX.bTarWorking,
	bSyncEnabled := fbBiaxialCoordinator.bSyncActive,
	bSyncRelease := fbBiaxialCoordinator.bSyncRelease,
	bSyncAbort := fbBiaxialCoordinator.bAbortX,
    fForce := stSystemStatusX.fTenzoBuffer[stSystemStatusX.nBufferHead]);

fbMovementControllerY(
	Axis := GVL_Axis.yAxis,
	stMoveCommand := stMoveCommandY,
	stSettings := stSettingsY,
	fActPosition := GVL_Axis.yAxis.NcToPlc.ActPos,
    bPowerState := fbSafetyY.bPowerStatus,
	bHaltDone := fbSafetyY.bHaltDone,
	bSafetyError := fbSafetyY.bError,
	bProtectiveStop := fbSafetyY.bProtectiveStop,
	bExternalBusy := fbSafetyY.bHoming OR
		NOT fbSafetyY.bHomed OR stSystemStatusY.bTarWorking,
	bSyncEnabled := fbBiaxialCoordinator.bSyncActive,
	bSyncRelease := fbBiaxialCoordinator.bSyncRelease,
	bSyncAbort := fbBiaxialCoordinator.bAbortY,
	fForce := stSystemStatusY.fTenzoBuffer[stSystemStatusY.nBufferHead]);

///////////////////////////////////////////////////
////// ADS status contract for each axis //////////
///////////////////////////////////////////////////

fbStatusPublisherX(
	fActPosition := GVL_Axis.xAxis.NcToPlc.ActPos,
	bPowerStatus := fbSafetyX.bPowerStatus,
	bHoming := fbSafetyX.bHoming,
	bHomed := fbSafetyX.bHomed,
	bStopped := fbSafetyX.bStopped,
	bProtectiveStop := fbSafetyX.bProtectiveStop,
	bControllerHalt := fbMovementControllerX.stateHalt,
	bSafetyError := fbSafetyX.bError,
	nSafetyErrorCode := fbSafetyX.nErrorCode,
	nSafetyAxisErrorID := fbSafetyX.nAxisErrorID,
	bMovementBusy := fbMovementControllerX.bBusy,
	bMovementError := fbMovementControllerX.bError,
	nMovementStatus := fbMovementControllerX.nSystemStatus,
	nMovementErrorCode := fbMovementControllerX.nErrorCode,
	nMovementAxisErrorID := fbMovementControllerX.nAxisErrorID,
	nOperationCounter := fbMovementControllerX.nOperationCounter,
	bSavedPositionValid := fbMovementControllerX.bSavedPositionValid,
	bStartError := fbBiaxialCoordinator.bStartError,
	nStartErrorCode := fbBiaxialCoordinator.nStartErrorCode,
	stSystemStatus := stSystemStatusX);

fbStatusPublisherY(
	fActPosition := GVL_Axis.yAxis.NcToPlc.ActPos,
	bPowerStatus := fbSafetyY.bPowerStatus,
	bHoming := fbSafetyY.bHoming,
	bHomed := fbSafetyY.bHomed,
	bStopped := fbSafetyY.bStopped,
	bProtectiveStop := fbSafetyY.bProtectiveStop,
	bControllerHalt := fbMovementControllerY.stateHalt,
	bSafetyError := fbSafetyY.bError,
	nSafetyErrorCode := fbSafetyY.nErrorCode,
	nSafetyAxisErrorID := fbSafetyY.nAxisErrorID,
	bMovementBusy := fbMovementControllerY.bBusy,
	bMovementError := fbMovementControllerY.bError,
	nMovementStatus := fbMovementControllerY.nSystemStatus,
	nMovementErrorCode := fbMovementControllerY.nErrorCode,
	nMovementAxisErrorID := fbMovementControllerY.nAxisErrorID,
	nOperationCounter := fbMovementControllerY.nOperationCounter,
	bSavedPositionValid := fbMovementControllerY.bSavedPositionValid,
	bStartError := fbBiaxialCoordinator.bStartError,
	nStartErrorCode := fbBiaxialCoordinator.nStartErrorCode,
	stSystemStatus := stSystemStatusY);

// Track the last valid coordinate continuously in persistent PLC memory.
// Values are never replaced while an axis is unreferenced, homing, or in an
// NC error, so startup cannot accidentally retain the raw zero coordinate.
IF fbSafetyX.bHomed AND NOT fbSafetyX.bHoming AND
	NOT GVL_Axis.xAxis.Status.Error AND
	(GVL_Axis.xAxis.NcToPlc.ActPos =
		GVL_Axis.xAxis.NcToPlc.ActPos) AND
	ABS(GVL_Axis.xAxis.NcToPlc.ActPos) < 1.0E300 THEN
	GVL_Persistent.fLastPositionX :=
		GVL_Axis.xAxis.NcToPlc.ActPos;
	GVL_Persistent.bLastPositionValidX := TRUE;
END_IF

IF fbSafetyY.bHomed AND NOT fbSafetyY.bHoming AND
	NOT GVL_Axis.yAxis.Status.Error AND
	(GVL_Axis.yAxis.NcToPlc.ActPos =
		GVL_Axis.yAxis.NcToPlc.ActPos) AND
	ABS(GVL_Axis.yAxis.NcToPlc.ActPos) < 1.0E300 THEN
	GVL_Persistent.fLastPositionY :=
		GVL_Axis.yAxis.NcToPlc.ActPos;
	GVL_Persistent.bLastPositionValidY := TRUE;
END_IF

// Home and reset are one-shot commands
stMoveCommandX.bHome := FALSE;
stMoveCommandY.bHome := FALSE;
stMoveCommandX.bReset := FALSE;
stMoveCommandY.bReset := FALSE;
stMoveCommandX.bSavePosition := FALSE;
stMoveCommandY.bSavePosition := FALSE;
stMoveCommandX.bRestorePosition := FALSE;
stMoveCommandY.bRestorePosition := FALSE;









]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="6943" Count="57" />
      <LineId Id="7035" Count="0" />
      <LineId Id="7037" Count="0" />
      <LineId Id="7030" Count="0" />
      <LineId Id="7002" Count="1" />
      <LineId Id="7036" Count="0" />
      <LineId Id="7007" Count="2" />
      <LineId Id="7034" Count="0" />
      <LineId Id="7039" Count="0" />
      <LineId Id="7032" Count="0" />
      <LineId Id="7011" Count="1" />
      <LineId Id="7038" Count="0" />
      <LineId Id="7016" Count="9" />
      <LineId Id="65" Count="0" />
      <LineId Id="87" Count="1" />
      <LineId Id="7070" Count="1" />
      <LineId Id="89" Count="0" />
      <LineId Id="7073" Count="1" />
      <LineId Id="7072" Count="0" />
      <LineId Id="90" Count="47" />
      <LineId Id="143" Count="7" />
      <LineId Id="2" Count="0" />
      <LineId Id="152" Count="62" />
      <LineId Id="7075" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
