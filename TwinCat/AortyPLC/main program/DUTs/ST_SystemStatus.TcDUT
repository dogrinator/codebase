<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_SystemStatus" Id="{1f1ade43-23d7-4c7e-a80f-ab809b514cde}">
    <Declaration><![CDATA[TYPE ST_SystemStatus :
	STRUCT
		fPosBuffer   : ARRAY[1..50] OF LREAL; // Circular display-position samples
		fTenzoBuffer : ARRAY[1..50] OF LREAL; // Circular force samples
		nBufferHead  : INT := 50;             // Index of latest completely written sample
		nSampleCounter    : UDINT := 0;       // Wrapping sample counter for drop detection
		nOperationCounter : UDINT := 0;       // Incremented after each completed motion command
		nInterfaceVersion : UDINT := 6;       // MATLAB/PLC ADS contract version
		fTenzoTarOffset   : LREAL := 0.0;     // Calculated tar offset
		fActPosition : LREAL := 0.0;          // Display position (50 mm - NC position)
		
		bWorking     : BOOL;                   // PLC occupied; do not send a new test
		bTarWorking  : BOOL;                   // PLC is calculating tare
		bError       : BOOL;                   // Latched application or motion error
		nErrorCode   : UDINT := 0;             // Application error code (0 = no error)
		nAxisErrorID : UDINT := 0;             // Native TwinCAT/NC error ID
		bPowered     : BOOL;                   // Axis power is enabled
		bHoming      : BOOL;                   // Homing command is active
		bHomed       : BOOL;                   // NC axis reports a valid home reference
		bStopped     : BOOL;                   // Axis is at standstill
		bSavedPositionValid : BOOL;            // A return-to-saved reference is available
		nSystemStatus : INT := 0;              // High-level numeric system status
	END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
