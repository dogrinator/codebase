<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_MoveCommand" Id="{f7a5f6bb-0c5b-440f-b36c-9128ecf27acb}">
    <Declaration><![CDATA[TYPE ST_MoveCommand :
	STRUCT
		// Mode 1: one relative move
		fMoveDistance : LREAL;
		fMoveVelocity : LREAL;

		// Mode 2: one PI-regulated force hold
		fTargetForce   : LREAL;
		fForceDuration : LREAL;
	
		// Command and service controls
		nMode       : INT;  // 1=relative move, 2=force/time, 3=test sequence
		bExecute    : BOOL; // Start movement
		bHalt       : BOOL; // Panic stop
		bPower      : BOOL; // Maintained motor-enable request
		bReset      : BOOL; // Reset errors
		bHome       : BOOL; // Start homing sequence
		bStartTar   : BOOL; // Start tare sequence
		bSavePosition : BOOL; // Capture the current axis position while idle
		bRestorePosition : BOOL; // Return to the saved coordinate while idle
		fRestoreVelocity : LREAL; // Saved-position return speed [mm/s]

		// Optional force pre-conditioning sequence
		bIncludePreTest : BOOL;
		bPreTestOnly    : BOOL;  // Run pre-test and post-test without a main test
		nPreCycleCount  : INT;   // Number of force load/unload cycles, 0..50
		bPreloadEnabled : BOOL;  // Apply one force preload before the first cycle
		fPreloadValue   : LREAL; // Signed preload force [N]
		fPreCycleLoadValue : LREAL; // Signed repeated preconditioning load target [N]
		fPreUnloadValue : LREAL; // Signed force unload target [N]
		bPreUnloadToStart : BOOL; // Return to sequence-start position instead of force unload
		fPreTestRate     : LREAL; // Positive motor speed magnitude [mm/s]
		fPreTestForceTolerance : LREAL := 0.1; // [N], or negative for target-relative percent
		fPreloadHoldTime : LREAL := 0.0; // Hold time for the initial preload endpoint [s]
		fPreCycleHoldTime : LREAL := 0.0; // Hold time for cyclic pre-conditioning endpoints [s]

		// Main test settings
		fTestRate      : LREAL; // Positive motor speed magnitude [mm/s]
		fSingleForceTolerance : LREAL := 0.1; // [N], or negative for target-relative percent
		fSingleForceHoldTime : LREAL := 0.0; // Hold time for the single-test primary endpoint [s]
		fCyclicForceTolerance : LREAL := 0.1; // [N], or negative for target-relative percent
		fCyclicForceHoldTime : LREAL := 0.0; // Hold time for cyclic load/unload endpoints [s]

		// Test selection: >0=cyclic count, 0=single test
		nCycleCount : INT;
		nLoadMode   : INT;   // 1=displacement, 2=force
		fLoadValues : ARRAY[1..50] OF LREAL; // per-cycle level [mm] or signed force [N]
		nUnloadMode : INT;   // 1=displacement, 2=force
		fUnloadValues : ARRAY[1..50] OF LREAL; // per-cycle level [mm] or signed force [N]

		// Single test (nMode=3, nCycleCount=0); criterion 2 is optional OR
		nStop1Mode         : INT;   // 0=off, 1=displacement, 2=force
		fStop1Value        : LREAL;
		nStop2Mode         : INT;
		fStop2Value        : LREAL;

		// 0=stay, 1=saved position, 2=sequence start,
		// 3=pre-test final position, 4=unload to zero force
		nPostTestMode : INT;
	END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
